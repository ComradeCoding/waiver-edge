# Waiver Edge is a public tool - every visitor types in THEIR OWN Sleeper
# username/league in the app itself. Nothing here is required for the app
# to run or deploy.
#
# These two variables exist purely as a LOCAL DEV CONVENIENCE: if set, they
# pre-fill the "Find My League" form so you don't have to retype your own
# username every time you restart `streamlit run app.py` while developing.
# They are never read by anyone else's session, never sent anywhere but
# into your own browser's form fields, and have no effect at all in
# production (Railway) unless you happen to set them there too.
#
# Copy this file to .env and fill in your own values:
#   cp .env.example .env

WAIVER_EDGE_DEV_USERNAME=
WAIVER_EDGE_DEV_SEASON=2026
